# The lander's hands on workshop (#83m6zw8): one pass of queuebridge/pusher.py, which fast-forwards adamic main to each
# landing order's exact tested tree with the lander key (Host github-lander). Run by loom-pusher.timer every 30 s.
[Unit]
Description=Loom pusher: landing orders to adamic main, fast-forward only, with the lander key

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -B %h/loom-lander/bin/pusher.py
StandardOutput=append:%h/loom-lander/pusher.log
StandardError=append:%h/loom-lander/pusher.log
TimeoutStartSec=600
