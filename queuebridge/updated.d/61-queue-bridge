#!/bin/sh
# The updater's hook for the queue bridge (package queuebridge), written by `loom queue-bridge install`: after every
# release it installs that release's loom-queue-bridge.service and loom-queue-bridge.timer, and never enables, starts or
# stops them. Only the bridge carries git's facts: without ~/.loom/queue-bridge.conf this machine isn't it, and the hook passes
# having installed nothing. A release from before `loom queue-bridge` (a rollback past it) has nothing to install, so
# the units are left as they are and the hook passes.
if [ ! -f "${HOME}/.loom/queue-bridge.conf" ]; then
	echo "61-queue-bridge: no ${HOME}/.loom/queue-bridge.conf, so this machine isn't the bridge; nothing installed"
	exit 0
fi
loom=${LOOM_UPDATE_BIN:-${HOME}/.loom/bin}/loom
if ! "${loom}" 2>&1 | grep -q '^  loom queue-bridge install'; then
	echo "61-queue-bridge: ${loom} has no queue-bridge install (a release from before it?); the bridge's units are left as they are"
	exit 0
fi
exec "${loom}" queue-bridge install
