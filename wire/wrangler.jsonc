// Loom's live wire: one Durable Object per run, one for the board, one per pool, blobs in R2. docs/protocol.md is the contract.
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "loom-runs",
    "main": "source/Worker.ts",
    "account_id": "de6c2d43baac01ee481466e683f83e64",
    "compatibility_date": "2026-10-01",
    "workers_dev": true,
    "preview_urls": false,
    // The board's address for Kirk; workers.dev stays for runners and scripts.
    "routes": [{ "pattern": "runs.loom.system.inc", "custom_domain": true }],
    "observability": { "enabled": true },
    "durable_objects": {
        "bindings": [
            { "name": "Runs", "class_name": "RunObject" },
            { "name": "Board", "class_name": "Board" },
            { "name": "Pools", "class_name": "Pool" }
        ]
    },
    "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["RunObject"] },
        { "tag": "v2", "new_sqlite_classes": ["Board"] },
        { "tag": "v3", "new_sqlite_classes": ["Pool"] }
    ],
    "r2_buckets": [
        { "binding": "Store", "bucket_name": "loom-runs" },
        // Adamic's open-source build products and test inputs: read by anyone at artifacts.loom.system.inc
        // (every reader verifies the hash it asked for), written only through this Worker by a coordinator.
        { "binding": "PublicStore", "bucket_name": "loom-artifacts" }
    ]
    // LOOM_TOKEN_SECRET is a secret: wrangler secret put LOOM_TOKEN_SECRET
}
