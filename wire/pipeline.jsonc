// loom: the deterministic path from a submitted change to main (the gospel on #system_adamic_loom; the
// contracts in docs/contracts.md). Its own Worker beside loom-runs, which stays frozen until cutover, sharing this
// directory's token, event and HTTP code. Each part adds its own bindings here: Queue its Durable Object and
// migration. LOOM_TOKEN_SECRET is the same secret as loom-runs's: wrangler secret put LOOM_TOKEN_SECRET --config pipeline.jsonc
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "loom",
    "main": "source/Pipeline.ts",
    "account_id": "de6c2d43baac01ee481466e683f83e64",
    "compatibility_date": "2026-10-01",
    "workers_dev": true,
    "preview_urls": false,
    "routes": [{ "pattern": "loom.system.inc", "custom_domain": true }],
    "observability": { "enabled": true },
    // No bucket: the action store (loom-artifacts) is written straight through R2's S3 interface by a builder's own
    // key (builder/store.go) and read by anyone at artifacts.loom.system.inc, never through this Worker.
    "durable_objects": {
        "bindings": [
            { "name": "ChangeBoard", "class_name": "ChangeBoard" },
            // The queue: one object, idFromName('main'), the single writer of main's future and the only writer of main.
            { "name": "Queue", "class_name": "Queue" },
            // The page's headline (#lmboard): one object, idFromName('headline'), following the Queue's log.
            { "name": "Headline", "class_name": "Headline" }
        ]
    },
    "migrations": [
        { "tag": "changeboard-v1", "new_sqlite_classes": ["ChangeBoard"] },
        { "tag": "queue-v1", "new_sqlite_classes": ["Queue"] },
        { "tag": "headline-v1", "new_sqlite_classes": ["Headline"] }
    ]
    // GITHUB_TOKEN reads git facts at submit; GITHUB_LANDER_TOKEN moves main, minted by Kirk at cutover.
}
