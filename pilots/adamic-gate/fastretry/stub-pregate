#!/bin/bash
# Stub loom-pregate: run ... --record <file> <job.json>. Outcome per attempt from $STUB/plan, line N for the Nth call:
# "<unit>=<passed|failed|exit2|nofinish|noupload> ..." (unlisted units pass).
record= job=
while [ $# -gt 0 ]; do case $1 in --record) record=$2; shift 2 ;; --pool|--priority|--slots) shift 2 ;; run|--uncached) shift ;; *) job=$1; shift ;; esac; done
n=$(( $(cat $STUB/calls 2> /dev/null || echo 0) + 1 )); echo $n > $STUB/calls
cp "$job" $STUB/job-$n.json
plan=$(sed -n "${n}p" $STUB/plan)
run=stub-run-$n
echo "run ${run}: units, uncached"
python3 - "$job" "$record" "$run" "$plan" <<'PY'
import json, sys
job, record, run, plan = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
outcome = dict(item.split("=") for item in plan.split())
with open(record, "w") as out:
    for unit in json.load(open(job))["units"]:
        u = unit["id"]; o = outcome.get(u, "passed")
        out.write(json.dumps({"run": run, "unit": u, "type": "started", "machine": "m%d" % len(u)}, separators=(",", ":")) + "\n")
        if o == "nofinish":
            print("%s: dropped by pool:codex after 3 events: the coordinator was stopped" % u); continue
        code = {"passed": 0, "failed": 1, "exit2": 2, "noupload": 0}[o]
        if o != "noupload" and u.startswith("phase-fast"):
            out.write(json.dumps({"run": run, "unit": u, "type": "uploaded", "path": "loom-out/phase.tar.gz", "sha256": "abc"}, separators=(",", ":")) + "\n")
        out.write(json.dumps({"run": run, "unit": u, "type": "exit", "code": code}, separators=(",", ":")) + "\n")
        status = "passed" if code == 0 else "failed"
        out.write(json.dumps({"run": run, "unit": u, "type": "finished", "status": status}, separators=(",", ":")) + "\n")
        print("%s: %s on pool:codex in 1.0 s" % (u, status))
PY
