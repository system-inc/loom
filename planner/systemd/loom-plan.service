# Loom's planner on Workshop: `loom plan`'s pull loop (cmd/loom/plan.go, planner/pull.go), beside loom-place and
# loom-build-trees. Every 10 s: GET /futures?state=unplanned, check each tree out keyless, key its units and its tree,
# POST /futures/<tree>/plan. A user unit, installed as the placer's is (docs/updater.md):
#
#   cp planner/systemd/loom-plan.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user restart loom-plan.service
#
# Token: ~/.loom/planner-token, scope coordinator, run "planner", read once at start: a re-minted token needs a restart.
# Reads: ~/.loom/runner-pin (re-read every pull, the pool's runner sha256 in every test key); ~/.loom/gate-inputs-manifest
# (the gate inputs' manifest sha256: without it no change future is planned); ~/.loom/pools.json; ~/.loom/no-reuse
# (optional); the clone ~/loom-planner/adamic (checked out per future, submodules over https); the gate tools
# ~/loom-planner/tools, moved to origin's loom/planner-reads before every pull. Calls https://loom.system.inc and GitHub
# over https. run.py (phase units) needs python3.
#
# Its environment is loom-build-trees': adamic's toolchain (~/adamic-tools/env.sh) under GOTOOLCHAIN=local. The unit
# key's tools part is probed from it at start (`go env GOVERSION`, `clang --version`, `node --version`,
# $WASI_SDK_VERSION), so a different PATH keys every unit differently and nothing in Queue's index is reused; and each
# tree's key names the local go's release, which must be the release the tree's toolchain line names and the release
# its units are keyed on, or the tree isn't planned, named.
[Unit]
Description=Loom planner: plans every unplanned future and posts its plan
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/loom-planner
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=GOTOOLCHAIN=local
ExecStart=/bin/bash -c '. %h/adamic-tools/env.sh && exec %h/.loom/bin/loom plan --queue https://loom.system.inc --token-file %h/.loom/planner-token --repository %h/loom-planner/adamic --gate-tools %h/loom-planner/tools --gate-tools-ref loom/planner-reads --runner-sha-file %h/.loom/runner-pin --gate-inputs-file %h/.loom/gate-inputs-manifest --pools %h/.loom/pools.json --no-reuse %h/.loom/no-reuse --interval 10s'
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
